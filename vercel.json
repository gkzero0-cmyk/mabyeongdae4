{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/", "destination": "/index.html"}
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, s-maxage=1, stale-while-revalidate=4"}]
    }
  ]
}
